<h1 class="text-4xl font-black tracking-tight">you</h1>

<section class="mt-6 rounded-3xl border-2 border-ink bg-sign p-5 shadow-[5px_5px_0_0_var(--color-ink)]">
  <h2 class="text-xl font-black">home station 🏠</h2>
  <p class="mt-1 text-steel">filled in as your station every time you plan a meetup.</p>

  <%= form_with url: home_station_path, method: :patch, class: "mt-4" do %>
    <div data-controller="station-picker"
         data-station-picker-url-value="<%= stations_path %>"
         data-station-picker-nearest-url-value="<%= nearest_station_path %>"
         data-action="click@window->station-picker#closeOnOutside"
         class="relative flex gap-2">
      <input type="text" name="name" autocomplete="off"
             value="<%= [home_station&.dig(:name), home_station&.dig(:romaji)].compact.join(' ') %>"
             placeholder="station, e.g. shibuya or 渋谷"
             aria-label="Home station"
             data-station-picker-target="input"
             data-action="input->station-picker#search keydown.esc->station-picker#close"
             class="flex-1 min-w-0 rounded-2xl border-2 border-rail bg-platform px-4 py-3 text-base placeholder:text-steel focus:border-ink">
      <input type="hidden" name="group_code" value="<%= home_station&.dig(:group_code) %>"
             data-station-picker-target="value">
      <button type="button" data-action="station-picker#locate"
              class="press px-2 text-steel hover:text-ink" aria-label="Use my location">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="2.5"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/>
        </svg>
      </button>
      <div data-station-picker-target="list" hidden
           class="absolute left-0 right-12 top-full z-10 mt-1 overflow-hidden rounded-2xl border border-rail bg-sign shadow-lg"></div>
    </div>

    <%= submit_tag "save", name: nil,
          class: "btn-pop mt-5 w-full rounded-full py-3 text-lg font-black cursor-pointer" %>
  <% end %>

  <% if home_station %>
    <%= button_to "clear home station", home_station_path, method: :delete,
          class: "press mt-4 w-full rounded-full py-2 font-bold text-steel hover:text-ink cursor-pointer" %>
  <% end %>
</section>

<section class="mt-10">
  <h2 class="text-xl font-black">about midstop</h2>
  <p class="mt-2 text-steel">finds the station where nobody in the crew has a way longer trip than everyone else. travel times are estimates based on distance and transfers.</p>
  <p class="mt-4 text-sm text-steel">
    station data from <%= link_to "station_database", "https://github.com/Seo-4d696b75/station_database", class: "underline", target: "_blank", rel: "noopener" %>
    (CC BY 4.0). map and places © <%= link_to "OpenStreetMap contributors", "https://www.openstreetmap.org/copyright", class: "underline", target: "_blank", rel: "noopener" %>.
  </p>
</section>
