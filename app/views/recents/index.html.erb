<div class="flex items-baseline justify-between gap-4">
  <h1 class="text-4xl font-black tracking-tight">Recent</h1>
  <% if @recents.any? %>
    <%= button_to "Clear", recent_path, method: :delete,
          form: { data: { turbo_confirm: "Clear all recent searches?" } },
          class: "text-sm font-medium text-steel hover:text-ink cursor-pointer" %>
  <% end %>
</div>

<% if @recents.empty? %>
  <div class="mt-6 rounded-3xl border border-rail bg-sign p-6">
    <p class="font-bold">No searches yet</p>
    <p class="mt-1 text-steel">Every meetup you look up is kept here, so you can reopen it or tweak the stations.</p>
    <%= link_to "Plan a meetup", root_path, class: "mt-4 inline-block rounded-full bg-ink px-5 py-3 font-bold text-white hover:bg-steel" %>
  </div>
<% else %>
  <ul class="mt-6 divide-y divide-rail rounded-2xl border border-rail bg-sign">
    <% @recents.each do |entry| %>
      <% codes = Array(entry["codes"]) %>
      <% best = @labels[entry["best"]] %>
      <li class="px-5 py-4">
        <div class="flex items-baseline justify-between gap-3">
          <p class="min-w-0">
            <span class="font-bold" lang="ja"><%= best&.dig(:name) || "No meeting spot" %></span>
            <span class="text-steel"><%= best&.dig(:romaji) %></span>
          </p>
          <span class="shrink-0 text-sm text-steel"><%= relative_day(entry["at"]) %></span>
        </div>
        <p class="mt-1 text-sm text-steel">
          from <%= codes.filter_map { |code| @labels.dig(code, :romaji) || @labels.dig(code, :name) }.to_sentence %>
        </p>
        <div class="mt-3 flex gap-2">
          <%= link_to "Reopen", meet_path(from: codes),
                class: "rounded-full bg-ink px-4 py-2 text-sm font-bold text-white hover:bg-steel" %>
          <%= link_to "Tweak stations", root_path(from: codes),
                class: "rounded-full border border-rail px-4 py-2 text-sm font-medium hover:border-ink" %>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>
