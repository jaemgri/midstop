<h1 class="text-4xl font-black tracking-tight"><%= t(".title") %></h1>

<% if @crews.any? %>
  <section class="mt-6">
    <h2 class="text-xl font-black"><%= t(".your_crews") %></h2>
    <ul class="mt-3 divide-y-2 divide-rail overflow-hidden rounded-2xl border-2 border-rail bg-sign">
      <% @crews.each do |crew| %>
        <li>
          <%= link_to crew_path(crew), class: "press flex items-center justify-between gap-3 px-5 py-4 hover:bg-platform" do %>
            <span class="min-w-0">
              <span class="block truncate font-bold"><%= crew.name %></span>
              <span class="block truncate text-sm text-steel">
                <%= crew.members.select(&:claimed?).map(&:name).to_sentence %>
              </span>
            </span>
            <span class="text-steel" aria-hidden="true">›</span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<% if @spots.empty? && @groups.empty? %>
  <div class="animate-arrive mt-6 rounded-3xl border-2 border-ink bg-sign p-6 shadow-[5px_5px_0_0_var(--color-ink)]">
    <p class="text-3xl" aria-hidden="true">⭐️</p>
    <p class="mt-2 text-lg font-black"><%= t(".empty_title") %></p>
    <p class="mt-1 text-steel"><%= t(".empty_text") %></p>
    <%= link_to t(".plan"), root_path, class: "btn-pop mt-5 inline-block rounded-full px-5 py-3 font-black" %>
  </div>
<% else %>
  <section class="mt-6">
    <h2 class="text-xl font-black"><%= t(".crews") %></h2>
    <% if @groups.any? %>
      <ul class="stagger mt-3 space-y-3">
        <% @groups.each do |group| %>
          <li id="saved_group_<%= group["id"] %>" class="rounded-2xl border border-rail bg-sign px-5 py-4">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <p class="text-lg font-black"><%= group["name"] %></p>
                <p class="text-sm text-steel"><%= station_list(@labels, group["codes"]) %></p>
              </div>
              <%= button_to t(".remove"), saved_group_path(group["id"]), method: :delete,
                    "aria-label": t(".remove_label", name: group["name"]),
                    class: "press shrink-0 text-sm font-bold text-steel hover:text-ink cursor-pointer" %>
            </div>
            <%= link_to t(".find"), meet_path(from: group["codes"]),
                  class: "btn-pop mt-4 inline-block rounded-full px-4 py-2 text-sm font-black" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-2 text-steel"><%= t(".no_crews") %></p>
    <% end %>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-black"><%= t(".spots") %></h2>
    <% if @spots.any? %>
      <ul class="stagger mt-3 divide-y divide-rail rounded-2xl border border-rail bg-sign">
        <% @spots.each do |code| %>
          <% label = @labels[code] %>
          <% next unless label %>
          <li id="saved_spot_row_<%= code %>" class="flex items-center justify-between gap-3 px-5 py-3">
            <%= link_to spot_path(code), class: "press min-w-0 flex-1" do %>
              <span class="font-black" lang="ja"><%= label[:name] %></span>
              <span class="text-steel"><%= label[:romaji] %></span>
            <% end %>
            <%= render "saved_spots/button", code: code %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-2 text-steel"><%= t(".no_spots") %></p>
    <% end %>
  </section>
<% end %>
