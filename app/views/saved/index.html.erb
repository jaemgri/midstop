<h1 class="text-4xl font-black tracking-tight">saved</h1>

<% if @spots.empty? && @groups.empty? %>
  <div class="animate-arrive mt-6 rounded-3xl border-2 border-ink bg-sign p-6 shadow-[5px_5px_0_0_var(--color-ink)]">
    <p class="text-3xl" aria-hidden="true">⭐️</p>
    <p class="mt-2 text-lg font-black">nothing saved yet</p>
    <p class="mt-1 text-steel">star your go-to spots and save your crews from any result. they'll live here.</p>
    <%= link_to "plan a meetup", root_path, class: "btn-pop mt-5 inline-block rounded-full px-5 py-3 font-black" %>
  </div>
<% else %>
  <section class="mt-6">
    <h2 class="text-xl font-black">your crews</h2>
    <% if @groups.any? %>
      <ul class="stagger mt-3 space-y-3">
        <% @groups.each do |group| %>
          <li id="saved_group_<%= group["id"] %>" class="rounded-2xl border border-rail bg-sign px-5 py-4">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <p class="text-lg font-black"><%= group["name"] %></p>
                <p class="text-sm text-steel">
                  <%= group["codes"].filter_map { |code| @labels.dig(code, :romaji) || @labels.dig(code, :name) }.to_sentence %>
                </p>
              </div>
              <%= button_to "remove", saved_group_path(group["id"]), method: :delete,
                    "aria-label": "Remove #{group['name']}",
                    class: "press shrink-0 text-sm font-bold text-steel hover:text-ink cursor-pointer" %>
            </div>
            <%= link_to "find our spot", meet_path(from: group["codes"]),
                  class: "btn-pop mt-4 inline-block rounded-full px-4 py-2 text-sm font-black" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-2 text-steel">save the crew from any result to re-run it in one tap.</p>
    <% end %>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-black">go-to spots</h2>
    <% if @spots.any? %>
      <ul class="stagger mt-3 divide-y divide-rail rounded-2xl border border-rail bg-sign">
        <% @spots.each do |code| %>
          <% label = @labels[code] %>
          <% next unless label %>
          <li id="saved_spot_row_<%= code %>" class="flex items-center justify-between gap-3 px-5 py-3">
            <%= link_to spot_path(code), class: "press min-w-0 flex-1" do %>
              <span class="font-black" lang="ja"><%= label[:name] %></span>
              <span class="text-steel"><%= label[:romaji] %></span>
            <% end %>
            <%= render "saved_spots/button", code: code %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-2 text-steel">star a meeting spot from any result to keep it here.</p>
    <% end %>
  </section>
<% end %>
