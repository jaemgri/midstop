<nav aria-label="Main" class="fixed inset-x-0 bottom-0 z-30 border-t border-rail bg-sign/95 backdrop-blur pb-[env(safe-area-inset-bottom)]">
  <ul class="mx-auto grid max-w-xl grid-cols-4">
    <% tab_bar_tabs.each do |tab| %>
      <li>
        <%= link_to tab[:href],
              "aria-current": (tab[:active] ? "page" : nil),
              class: "flex min-h-14 flex-col items-center justify-center gap-1 pt-1 pb-2 text-xs font-medium #{tab[:active] ? 'text-ink' : 'text-steel hover:text-ink'}" do %>
          <span class="h-1 w-6 rounded-full <%= tab[:active] ? 'bg-tactile' : 'bg-transparent' %>" aria-hidden="true"></span>
          <%= tab_icon(tab[:icon]) %>
          <span><%= tab[:label] %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
</nav>
