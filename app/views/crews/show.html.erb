<% content_for :title, @crew.name %>

<div class="animate-arrive">
  <p class="text-sm font-bold text-steel"><%= t(".label") %></p>
  <h1 class="text-3xl font-black"><%= @crew.name %></h1>
  <p class="mt-1 text-steel">
    <%= t(".seats", claimed: @crew.members.count(&:claimed?), total: @crew.members.size) %>
  </p>

  <div class="mt-6 flex flex-wrap gap-3">
    <%= link_to t(".find_spot"), meet_path(from: @crew.station_codes, crew: (@crew.token if @my_seat)),
          class: "btn-pop rounded-full px-6 py-3 text-lg font-black" %>

    <button type="button" class="btn-pop-light cursor-pointer rounded-full px-6 py-3 text-lg font-black"
            data-controller="share"
            data-action="share#share"
            data-share-url-value="<%= crew_url(@crew) %>"
            data-share-title-value="<%= @crew.name %>"
            data-share-text-value="<%= t(".share_text", crew: @crew.name) %>"
            data-share-copied-value="<%= t("meetups.show.copied") %>"
            data-share-failed-value="<%= t("meetups.show.copy_failed") %>">
      <%= t(".invite") %>
    </button>
  </div>

  <h2 class="mt-10 text-xl font-black"><%= t(".whos_in") %></h2>
  <ul class="mt-3 divide-y-2 divide-rail overflow-hidden rounded-2xl border-2 border-rail bg-sign">
    <% @crew.members.each do |seat| %>
      <li class="px-5 py-4">
        <div class="flex items-center justify-between gap-3">
          <div class="min-w-0">
            <p class="truncate font-bold">
              <% if seat.claimed? %>
                <%= seat.name %>
                <% if seat == @my_seat %><span class="text-steel"><%= t(".you") %></span><% end %>
              <% else %>
                <span class="text-steel"><%= t(".open_seat") %></span>
              <% end %>
            </p>
            <p class="truncate text-sm text-steel">🚉 <%= station_label(@labels[seat.group_code]) %></p>
          </div>

          <% if seat == @my_seat %>
            <%= button_to t(".leave"), crew_seat_path(@crew, seat), method: :delete,
                  form: { data: { turbo_confirm: t(".leave_confirm") } },
                  class: "press shrink-0 cursor-pointer text-sm font-bold text-steel underline underline-offset-4" %>
          <% end %>
        </div>

        <% if !seat.claimed? && @my_seat.nil? %>
          <%= form_with url: crew_seat_path(@crew, seat), method: :patch, class: "mt-3 flex gap-2" do %>
            <%= label_tag "name_#{seat.id}", t(".your_name"), class: "sr-only" %>
            <%= text_field_tag :name, nil, id: "name_#{seat.id}", required: true, maxlength: 30,
                  placeholder: t(".your_name"), autocomplete: "given-name",
                  class: "min-w-0 flex-1 rounded-full border-2 border-rail bg-platform px-4 py-2 placeholder:text-steel focus:border-ink focus:outline-none" %>
            <%= submit_tag t(".thats_me"), name: nil, class: "btn-pop cursor-pointer rounded-full px-4 font-black" %>
          <% end %>
        <% end %>
      </li>
    <% end %>
  </ul>
  <h2 class="mt-10 text-xl font-black"><%= t(".history") %></h2>
  <% if @visits.empty? %>
    <p class="mt-2 text-steel"><%= t(".no_history") %></p>
  <% else %>
    <p class="mt-1 text-steel"><%= t(".history_count", count: @crew.visits.count) %></p>
    <ul class="mt-3 divide-y-2 divide-rail overflow-hidden rounded-2xl border-2 border-rail bg-sign">
      <% @visits.each do |visit| %>
        <li class="flex items-start gap-3 px-5 py-4">
          <% if visit.photo.present? %>
            <%= image_tag visit.photo, alt: "", loading: "lazy", width: 56, height: 56,
                  class: "size-14 shrink-0 rounded-xl border-2 border-rail bg-rail object-cover" %>
          <% end %>
          <div class="min-w-0 flex-1">
            <p class="font-bold leading-snug">
              <% if visit.url.present? %>
                <%= link_to visit.place_name, visit.url, target: "_blank", rel: "noopener", class: "underline-offset-4 hover:underline" %>
              <% else %>
                <%= visit.place_name %>
              <% end %>
            </p>
            <p class="truncate text-sm text-steel">
              🚉 <%= station_label(@labels[visit.group_code]) %>
              <% if visit.genre.present? %> · <%= place_genre(visit.genre) %><% end %>
            </p>
            <p class="text-sm text-steel">
              <%= visit.visited_on.strftime(t("visits.date_format")) %>
              <% if visit.logged_by.present? %> · <%= t(".logged_by", name: visit.logged_by) %><% end %>
            </p>
          </div>
          <% if @my_seat %>
            <%= button_to t(".remove_visit"), crew_visit_path(@crew, visit), method: :delete,
                  form: { data: { turbo_confirm: t(".remove_confirm", place: visit.place_name) } },
                  class: "press shrink-0 cursor-pointer text-sm font-bold text-steel underline underline-offset-4" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
