<%= turbo_frame_tag "nearby" do %>
  <% chip = "inline-block whitespace-nowrap rounded-full border px-4 py-2 text-sm font-medium transition-colors" %>
  <% on = "#{chip} border-ink bg-ink text-white" %>
  <% off = "#{chip} border-rail bg-sign hover:border-ink" %>
  <% showing_all = @filter.nil? && @query.blank? %>

  <nav aria-label="Filter places" class="-mx-5 mt-3 overflow-x-auto px-5 pb-1">
    <ul class="flex w-max gap-2">
      <li>
        <%= link_to "All", places_path(@group_code), class: (showing_all ? on : off), "aria-current": (showing_all ? "true" : nil) %>
      </li>
      <% NearbyPlaces::FILTERS.each do |key, filter| %>
        <li>
          <%= link_to filter[:label], places_path(@group_code, type: key),
                class: (@filter == key ? on : off), "aria-current": (@filter == key ? "true" : nil) %>
        </li>
      <% end %>
    </ul>
  </nav>

  <%= form_with url: places_path(@group_code), method: :get, role: "search", class: "mt-3 flex gap-2" do %>
    <%= search_field_tag :q, @query, placeholder: "Search, e.g. sushi, 焼き鳥, burger",
          "aria-label": "Search places near #{@station[:romaji] || @station[:name]}",
          class: "flex-1 min-w-0 rounded-full border border-rail bg-sign px-4 py-2 text-base placeholder:text-steel" %>
    <%= submit_tag "Search", name: nil,
          class: "rounded-full bg-ink px-5 font-bold text-white hover:bg-steel cursor-pointer" %>
  <% end %>

  <% if @places.nil? %>
    <p class="mt-4 text-steel">Couldn't load nearby places right now. Try again in a minute.</p>
  <% elsif @places.empty? %>
    <p class="mt-4 text-steel">
      Nothing mapped for that within a short walk.
      <%= link_to "Show everything", places_path(@group_code), class: "font-medium text-ink underline" %>
    </p>
  <% else %>
    <% @places.each do |heading, places| %>
      <h3 class="mt-5 text-sm font-bold text-steel"><%= heading %></h3>
      <ul class="mt-2 divide-y divide-rail rounded-2xl border border-rail bg-sign">
        <% places.each do |place| %>
          <li>
            <%= link_to "https://www.google.com/maps/search/?api=1&query=#{ERB::Util.url_encode("#{place.name} #{@station[:name]}")}",
                  target: "_blank", rel: "noopener",
                  class: "flex items-baseline justify-between gap-4 px-5 py-3 hover:bg-platform" do %>
              <span class="min-w-0">
                <span class="block truncate"><%= place.name %></span>
                <% if place.name_en.present? && place.name_en != place.name %>
                  <span class="block truncate text-sm text-steel"><%= place.name_en %></span>
                <% end %>
              </span>
              <span class="shrink-0 text-sm text-steel tabular-nums"><%= place.walk_minutes %> min walk</span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
<% end %>
