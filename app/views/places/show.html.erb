<%= turbo_frame_tag "nearby" do %>
  <%# Genre chips %>
  <nav aria-label="<%= t(".filters_label") %>" class="flex gap-2 overflow-x-auto pb-1">
    <% [nil, *NearbyPlaces::FILTERS.keys].each do |filter| %>
      <% active = @filter == filter && @query.blank? %>
      <%= link_to t(".filters.#{filter || "all"}"),
            places_path(@group_code, type: filter, budget: params[:budget].presence),
            aria: { current: active ? "true" : nil },
            class: "press shrink-0 rounded-full border-2 px-4 py-2 font-bold #{active ? "border-ink bg-ink text-sign" : "border-rail bg-sign"}" %>
    <% end %>
  </nav>

  <%# Budget chips (Hot Pepper only: OpenStreetMap has no prices) %>
  <% if @source == :hotpepper %>
    <nav aria-label="<%= t(".budget_label") %>" class="mt-3 flex gap-2 overflow-x-auto pb-1">
      <% [nil, *DeviceMemory::BUDGETS].each do |amount| %>
        <% active = @budget == amount %>
        <%= link_to (amount ? t(".budget_upto", amount: number_with_delimiter(amount)) : t(".budget_any")),
              places_path(@group_code, type: @filter, q: @query.presence, budget: amount || "any"),
              aria: { current: active ? "true" : nil },
              class: "press shrink-0 rounded-full border-2 px-3 py-1 text-sm font-bold #{active ? "border-ink bg-ink text-sign" : "border-rail bg-sign"}" %>
      <% end %>
    </nav>
  <% end %>

  <%# Keyword search %>
  <%= form_with url: places_path(@group_code), method: :get, role: "search", class: "mt-4 flex gap-2" do %>
    <%= hidden_field_tag :budget, params[:budget] if params[:budget].present? %>
    <%= label_tag :q, t(".search_label"), class: "sr-only" %>
    <%= search_field_tag :q, @query, placeholder: t(".search_placeholder"), autocomplete: "off",
          class: "min-w-0 flex-1 rounded-full border-2 border-rail bg-sign px-5 py-3 placeholder:text-steel focus:border-ink focus:outline-none" %>
    <%= submit_tag t(".go"), name: nil, class: "btn-pop cursor-pointer rounded-full px-5 font-black" %>
  <% end %>

  <%# Results %>
  <% if @places.nil? %>
    <p class="mt-6 text-steel"><%= t(".unavailable") %></p>
  <% elsif @places.empty? %>
    <p class="mt-6 text-steel">
      <%= t(".empty") %>
      <%= link_to t(".show_everything"), places_path(@group_code, budget: "any"),
            class: "font-bold text-ink underline underline-offset-4" %>
    </p>
  <% else %>
    <% @places.each do |heading, places| %>
      <section class="mt-6">
        <h3 class="mb-2 text-sm font-bold text-steel"><%= t(".headings.#{heading}") %></h3>
        <ul class="divide-y-2 divide-rail overflow-hidden rounded-2xl border-2 border-rail bg-sign">
          <% places.each do |place| %>
            <%= render "places/place", place: place, station_name: @station[:name] %>
          <% end %>
        </ul>
      </section>
    <% end %>
  <% end %>

  <%# Credit for whichever source answered %>
  <p class="mt-4 text-xs text-steel">
    <% if @source == :hotpepper %>
      Powered by <%= link_to "ホットペッパーグルメ Webサービス", "http://webservice.recruit.co.jp/", class: "underline", target: "_blank", rel: "noopener" %>
      ・ 画像提供：ホットペッパー グルメ
    <% else %>
      Place data © <%= link_to "OpenStreetMap contributors", "https://www.openstreetmap.org/copyright", class: "underline", target: "_blank", rel: "noopener" %>
    <% end %>
  </p>
<% end %>
