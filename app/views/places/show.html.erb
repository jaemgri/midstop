<%= turbo_frame_tag "nearby" do %>
  <% chip = "press inline-block whitespace-nowrap rounded-full border-2 px-4 py-2 text-sm font-bold transition-colors" %>
  <% on = "#{chip} border-ink bg-ink text-sign" %>
  <% off = "#{chip} border-rail bg-sign hover:border-ink" %>
  <% showing_all = @filter.nil? && @query.blank? %>

  <nav aria-label="Filter places" class="-mx-5 mt-3 overflow-x-auto px-5 pb-1">
    <ul class="flex w-max gap-2">
      <li>
        <%= link_to t(".filters.all"), places_path(@group_code), class: (showing_all ? on : off), "aria-current": (showing_all ? "true" : nil) %>
      </li>
      <% NearbyPlaces::FILTERS.each_key do |key| %>
        <li>
          <%= link_to t(".filters.#{key}"), places_path(@group_code, type: key),
                class: (@filter == key ? on : off), "aria-current": (@filter == key ? "true" : nil) %>
        </li>
      <% end %>
    </ul>
  </nav>

  <%= form_with url: places_path(@group_code), method: :get, role: "search", class: "mt-3 flex gap-2" do %>
    <%= search_field_tag :q, @query, placeholder: t(".search_placeholder"),
          "aria-label": t(".search_label", station: station_label(@station)),
          class: "flex-1 min-w-0 rounded-full border-2 border-rail bg-sign px-4 py-2 text-base placeholder:text-steel focus:border-ink" %>
    <%= submit_tag t(".go"), name: nil,
          class: "btn-pop rounded-full px-5 font-black cursor-pointer" %>
  <% end %>

  <% if @places.nil? %>
    <p class="mt-4 text-steel"><%= t(".failed") %></p>
  <% elsif @places.empty? %>
    <p class="mt-4 text-steel">
      <%= t(".nothing") %>
      <%= link_to t(".show_all"), places_path(@group_code), class: "font-bold text-ink underline" %>
    </p>
  <% else %>
    <% @places.each do |heading, places| %>
      <h3 class="mt-5 text-sm font-black text-steel"><%= t(".headings.#{heading}") %></h3>
      <ul class="stagger mt-2 divide-y divide-rail rounded-2xl border border-rail bg-sign">
        <% places.each do |place| %>
          <li>
            <%= link_to place.url.presence || "https://www.google.com/maps/search/?api=1&query=#{ERB::Util.url_encode("#{place.name} #{@station[:name]}")}",
                  target: "_blank", rel: "noopener",
                  class: "press flex items-baseline justify-between gap-4 px-5 py-3 hover:bg-platform" do %>
              <span class="min-w-0">
                <span class="block truncate font-medium"><%= place.name %></span>
                <% details = [place.genre, place.budget].compact_blank.join(" · ") %>
                <% if details.present? %>
                  <span class="block truncate text-sm text-steel"><%= details %></span>
                <% elsif place.name_en.present? && place.name_en != place.name %>
                  <span class="block truncate text-sm text-steel"><%= place.name_en %></span>
                <% end %>
              </span>
              <span class="shrink-0 text-sm text-steel tabular-nums"><%= t(".walk", count: place.walk_minutes) %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
    <p class="mt-4 text-xs text-steel">
    <% if @source == :hotpepper %>
      Powered by <%= link_to "ホットペッパーグルメ Webサービス", "http://webservice.recruit.co.jp/", class: "underline", target: "_blank", rel: "noopener" %>
    <% else %>
      Place data © <%= link_to "OpenStreetMap contributors", "https://www.openstreetmap.org/copyright", class: "underline", target: "_blank", rel: "noopener" %>
    <% end %>
  </p>
<% end %>
