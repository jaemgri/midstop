<li>
  <%= link_to place_link(place, station_name), target: "_blank", rel: "noopener",
        class: "press flex items-start gap-3 px-5 py-4 hover:bg-platform focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ink" do %>
    <% if place.photo.present? %>
      <%= image_tag place.photo, alt: "", loading: "lazy", width: 72, height: 72,
            class: "size-18 shrink-0 rounded-xl border-2 border-rail bg-rail object-cover" %>
    <% end %>

    <span class="min-w-0 flex-1">
      <span class="flex items-baseline justify-between gap-3">
        <span class="font-bold leading-snug"><%= place.name %></span>
        <span class="shrink-0 text-sm text-steel"><%= t("places.place.walk", count: place.walk_minutes) %></span>
      </span>

      <% details = [place_genre(place.genre), place_budget(place.budget)].compact_blank.join(" · ") %>
      <% if details.present? %>
        <span class="mt-0.5 block truncate text-sm text-steel"><%= details %></span>
      <% elsif place.name_en.present? && place.name_en != place.name %>
        <span class="mt-0.5 block truncate text-sm text-steel"><%= place.name_en %></span>
      <% end %>

      <% if place.tagline.present? %>
        <span class="mt-1.5 line-clamp-2 block text-sm"><%= place.tagline %></span>
      <% end %>
    </span>
  <% end %>

  <div class="flex flex-wrap items-start gap-x-5 gap-y-1 px-5 pb-3 text-sm text-steel <%= "pl-26" if place.photo.present? %>">
    <% if place.lat && place.lon %>
      <%= link_to place_map_link(place), target: "_blank", rel: "noopener",
            class: "press font-bold underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" do %>
        📍 <%= t("places.place.map") %>
      <% end %>
    <% end %>

    <% if place.open.present? %>
      <details class="min-w-0 flex-1">
        <summary class="cursor-pointer select-none font-bold">🕒 <%= t("places.place.hours") %></summary>
        <p class="mt-1 leading-relaxed"><%= place_hours(place.open) %></p>
      </details>
    <% end %>
  </div>
</li>
