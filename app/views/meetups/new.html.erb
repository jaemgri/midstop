<section class="relative pt-2">
  <%= render "hero" %>
  <h1 class="pr-32 text-5xl font-black leading-[0.95] tracking-tight sm:pr-40 sm:text-6xl">
    <%= t(".heading_start") %><br><span class="highlight"><%= t(".heading_highlight") %></span>
  </h1>
  <p class="mt-4 max-w-sm text-lg text-steel"><%= t(".intro") %></p>
</section>

<% if home_station %>
  <p class="mt-6 text-sm text-steel">
    <%= t(".home_hint_html", station: home_station[:name],
          change: link_to(t(".change"), you_path, class: "font-bold text-ink underline")) %>
  </p>
<% else %>
  <p class="mt-6 text-sm text-steel">
    <%= t(".set_home_html", link: link_to(t(".set_home"), you_path, class: "font-bold text-ink underline")) %>
  </p>
<% end %>

<%= form_with url: meet_path, method: :get, data: { controller: "people" },
      class: "mt-4 rounded-3xl border border-rail bg-sign p-5" do %>
  <div data-people-target="list" class="space-y-3">
    <% rows = @prefill.presence || [home_station].compact %>
    <% rows.each do |station| %>
      <%= render "person_row", station: station %>
    <% end %>
    <% [2 - rows.size, 0].max.times do %>
      <%= render "person_row" %>
    <% end %>
  </div>

  <template data-people-target="template">
    <%= render "person_row" %>
  </template>

  <button type="button" data-action="people#add"
          class="press mt-4 font-bold text-steel hover:text-ink"><%= t(".add_person") %></button>

  <%= submit_tag t(".submit"), name: nil,
        class: "btn-pop mt-6 w-full rounded-full py-4 text-lg font-black cursor-pointer" %>
<% end %>

<% if @first_visit %>
  <section class="mt-10" aria-labelledby="how-it-works">
    <h2 id="how-it-works" class="text-xl font-black"><%= t(".how_it_works") %></h2>
    <ol class="mt-4 space-y-4">
      <% t(".steps").each_with_index do |step, index| %>
        <li class="flex gap-4">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border-[3px] border-ink bg-sign text-sm font-black tabular-nums" aria-hidden="true"><%= index + 1 %></span>
          <div>
            <p class="font-bold"><%= step[:title] %></p>
            <p class="text-steel"><%= step[:text] %></p>
          </div>
        </li>
      <% end %>
    </ol>
  </section>
<% end %>
