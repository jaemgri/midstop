<h1 class="text-4xl font-extrabold tracking-tight">where should we meet?</h1>
<p class="mt-3 text-gray-600">add everyone's nearest station and midstop finds the spot that's fairest for the whole group.</p>

<%= form_with url: meet_path, method: :get, data: { controller: "people" }, class: "mt-8" do %>
  <div data-people-target="list" class="space-y-3">
    <%= render "person_row" %>
    <%= render "person_row" %>
  </div>

  <template data-people-target="template">
    <%= render "person_row" %>
  </template>

  <button type="button" data-action="people#add"
          class="mt-3 text-sm font-semibold text-gray-600 hover:text-gray-900">+ add someone</button>

  <%= submit_tag "find the fairest station", name: nil,
        class: "mt-6 w-full rounded-full bg-gray-900 py-4 text-lg font-bold text-white hover:bg-gray-700 cursor-pointer" %>
<% end %>
