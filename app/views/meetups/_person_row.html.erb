<% station = local_assigns[:station] %>

<div data-person
     data-controller="station-picker"
     data-station-picker-url-value="<%= stations_path %>"
     data-action="click@window->station-picker#closeOnOutside"
     class="relative flex gap-2">
  <input type="text" autocomplete="off" name="names[]"
         value="<%= [station&.dig(:name), station&.dig(:romaji)].compact.join(' ') %>"
         placeholder="Station, e.g. Shibuya or 渋谷"
         aria-label="<%= station ? 'Your station' : 'Station' %>"
         data-station-picker-target="input"
         data-action="input->station-picker#search keydown.esc->station-picker#close"
         class="flex-1 min-w-0 rounded-2xl border border-rail bg-platform px-4 py-3 text-base placeholder:text-steel">
  <input type="hidden" name="from[]" value="<%= station&.dig(:group_code) %>" data-station-picker-target="value">
  <button type="button" data-action="people#remove"
          class="px-3 text-steel hover:text-ink" aria-label="Remove this person">✕</button>

  <div data-station-picker-target="list" hidden
       class="absolute left-0 right-12 top-full z-10 mt-1 overflow-hidden rounded-2xl border border-rail bg-sign shadow-lg"></div>
</div>
