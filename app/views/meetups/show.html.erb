<% content_for :head do %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css">
<% end %>

<% best, *others = @results %>

<%= link_to t(".back"), root_path(from: @group_codes), class: "press inline-block text-sm font-bold text-steel hover:text-ink" %>

<% if best.nil? %>
  <p class="mt-6 text-lg"><%= t(".no_station") %></p>
<% else %>
  <% best_label = { name: best.name, romaji: best.romaji } %>

  <h1 class="mt-5 text-3xl font-black leading-tight tracking-tight">
    <%= t(preferences[:ranking] == "fast" ? ".heading_fast_html" : ".heading_html", people: tag.span(t(".people", count: @group_codes.size), class: "highlight")) %>
  </h1>
  <p class="mt-1 text-steel"><%= station_list(@origins, @group_codes) %></p>

  <div class="mt-5">
    <%= render "shared/station_sign", name: best.name, romaji: best.romaji, longest: best.longest,
          badges: @badges[best.group_code], aria_label: "Fairest station" %>
  </div>

  <div data-controller="route-map"
       data-route-map-data-value="<%= @map_data.to_json %>"
       class="animate-arrive isolate mt-5 h-72 overflow-hidden rounded-3xl border-2 border-ink bg-sign [animation-delay:120ms]"
       role="img"
       aria-label="<%= t(".map_label", station: station_label(best_label)) %>"></div>

  <div class="mt-5 flex flex-wrap items-center gap-3">
    <div data-controller="share"
         data-share-url-value="<%= meet_url(from: @group_codes) %>"
         data-share-title-value="<%= t(".share_title", station: station_label(best_label)) %>"
         data-share-text-value="<%= t(".share_text", name: best.name, romaji: best.romaji, minutes: best.longest) %>"
         data-share-copied-value="<%= t(".copied") %>"
         data-share-failed-value="<%= t(".copy_failed") %>"
         class="contents">
      <button type="button" hidden data-share-target="share" data-action="share#share"
              class="btn-pop rounded-full px-5 py-2 font-black cursor-pointer"><%= t(".share") %></button>
      <button type="button" data-share-target="copy" data-action="share#copy"
              class="btn-pop rounded-full px-5 py-2 font-black cursor-pointer"><%= t(".copy") %></button>
    </div>
    <%= render "saved_spots/button", code: best.group_code %>
  </div>

  <div class="mt-4">
    <%= render "saved_groups/form", codes: @group_codes %>
  </div>

  <section class="mt-10">
    <h2 class="text-xl font-black"><%= t(".everyones_trip") %></h2>
    <ul class="stagger mt-3 divide-y divide-rail rounded-2xl border border-rail bg-sign">
      <% @group_codes.each_with_index do |code, person| %>
        <li class="flex items-center justify-between gap-4 px-5 py-3">
          <span class="flex min-w-0 items-center gap-2">
            <span class="flex shrink-0 gap-1"><%= line_badges(@badges[code], size: :sm, limit: 2) %></span>
            <span class="min-w-0 truncate">
              <span lang="ja"><%= @origins.dig(code, :name) %></span>
              <span class="text-steel"><%= @origins.dig(code, :romaji) %></span>
            </span>
          </span>
          <span class="shrink-0 font-black tabular-nums">
            <%= best.minutes[person].zero? ? t(".already_there") : t(".minutes", count: best.minutes[person]) %>
          </span>
        </li>
      <% end %>
    </ul>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-black"><%= t(".around", station: station_label(best_label)) %></h2>
    <%= turbo_frame_tag "nearby", src: places_path(best.group_code), loading: :lazy do %>
      <p class="mt-3 text-steel"><%= t("spots.show.loading", station: best.name) %></p>
    <% end %>
    <p class="mt-4 text-xs text-steel">
      Place data © <%= link_to "OpenStreetMap contributors", "https://www.openstreetmap.org/copyright", class: "underline", target: "_blank", rel: "noopener" %>
    </p>
  </section>

  <% if others.any? %>
    <section class="mt-10">
      <h2 class="text-xl font-black"><%= t(".also_fair") %></h2>
      <div class="stagger mt-3 divide-y divide-rail rounded-2xl border border-rail bg-sign">
        <% others.each do |result| %>
          <details class="group px-5 py-3">
            <summary class="press flex cursor-pointer list-none items-baseline justify-between gap-4">
              <span>
                <span class="font-bold" lang="ja"><%= result.name %></span>
                <span class="text-steel"><%= result.romaji %></span>
              </span>
              <span class="shrink-0 text-steel tabular-nums">
                <%= t(".longest_html", minutes: tag.span(t(".minutes", count: result.longest), class: "font-black text-ink")) %>
                <span class="ml-1 inline-block transition-transform group-open:rotate-90" aria-hidden="true">›</span>
              </span>
            </summary>
            <ul class="mt-2 space-y-1 text-sm text-steel">
              <% @group_codes.each_with_index do |code, person| %>
                <li class="flex justify-between">
                  <span><%= t(".from", station: station_label(@origins[code])) %></span>
                  <span class="tabular-nums">
                    <%= result.minutes[person].zero? ? t(".no_trip") : t(".minutes", count: result.minutes[person]) %>
                  </span>
                </li>
              <% end %>
            </ul>
          </details>
        <% end %>
      </div>
    </section>
  <% end %>
<% end %>
