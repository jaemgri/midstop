<% content_for :head do %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css">
<% end %>

<% best = @results.first %>

<%= link_to t(".back"), root_path(from: @group_codes), class: "press inline-block text-sm font-bold text-steel hover:text-ink" %>

<% if best.nil? %>
  <p class="mt-6 text-lg"><%= t(".no_station") %></p>
<% else %>
  <% best_label = { name: best.name, romaji: best.romaji } %>

  <h1 class="mt-5 text-3xl font-black leading-tight tracking-tight">
    <%= t(preferences[:ranking] == "fast" ? ".heading_fast_html" : ".heading_html", people: tag.span(t(".people", count: @group_codes.size), class: "highlight")) %>
  </h1>
  <p class="mt-1 text-steel"><%= station_list(@origins, @group_codes) %></p>

  <%# Group actions: these are about the whole search, not one station %>
  <div class="mt-5 flex flex-wrap items-center gap-3">
    <div data-controller="share"
         data-share-url-value="<%= meet_url(from: @group_codes) %>"
         data-share-title-value="<%= t(".share_title", station: station_label(best_label)) %>"
         data-share-text-value="<%= t(".share_text", name: best.name, romaji: best.romaji, minutes: best.longest) %>"
         data-share-copied-value="<%= t(".copied") %>"
         data-share-failed-value="<%= t(".copy_failed") %>"
         class="contents">
      <button type="button" hidden data-share-target="share" data-action="share#share"
              class="btn-pop rounded-full px-5 py-2 font-black cursor-pointer"><%= t(".share") %></button>
      <button type="button" data-share-target="copy" data-action="share#copy"
              class="btn-pop rounded-full px-5 py-2 font-black cursor-pointer"><%= t(".copy") %></button>
    </div>
    <%= render "saved_groups/form", codes: @group_codes %>
    <%= link_to t(".make_crew"), new_crew_path(from: @group_codes),
          class: "btn-pop-light press rounded-full px-5 py-2 font-black" %>
  </div>

  <%# The station carousel %>
  <section data-controller="carousel"
           data-action="keydown->carousel#keydown"
           aria-roledescription="carousel"
           aria-label="<%= t(".carousel_label") %>"
           class="mt-8">

    <div class="flex items-center gap-2">
      <button type="button" data-carousel-target="prev" data-action="carousel#previous"
              aria-label="<%= t(".prev") %>"
              class="press grid size-10 shrink-0 cursor-pointer place-items-center rounded-full border-2 border-ink bg-sign text-xl font-black disabled:cursor-default disabled:opacity-30">‹</button>

      <nav aria-label="<%= t(".stops_label") %>" class="min-w-0 flex-1 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        <ol class="flex w-max items-center py-1">
          <% @results.each_with_index do |result, index| %>
            <li class="flex items-center">
              <% if index.positive? %>
                <span class="h-1 w-4 bg-rail" aria-hidden="true"></span>
              <% end %>
              <button type="button"
                      data-carousel-target="stop"
                      data-action="carousel#jump"
                      data-carousel-index-param="<%= index %>"
                      class="press flex cursor-pointer items-center gap-1.5 whitespace-nowrap rounded-full border-2 border-rail bg-sign px-3 py-1.5 text-sm font-bold aria-[current=true]:border-ink aria-[current=true]:bg-tactile aria-[current=true]:text-on-tactile">
                <span class="tabular-nums opacity-60"><%= index + 1 %></span>
                <span><%= station_label(name: result.name, romaji: result.romaji) %></span>
              </button>
            </li>
          <% end %>
        </ol>
      </nav>

      <button type="button" data-carousel-target="next" data-action="carousel#next"
              aria-label="<%= t(".next") %>"
              class="press grid size-10 shrink-0 cursor-pointer place-items-center rounded-full border-2 border-ink bg-sign text-xl font-black disabled:cursor-default disabled:opacity-30">›</button>
    </div>

    <% if @results.size > 1 %>
      <p class="mt-2 text-center text-xs text-steel"><%= t(".swipe_hint") %></p>
    <% end %>

    <div data-carousel-target="track"
         class="animate-arrive relative mt-4 flex snap-x snap-mandatory items-start gap-4 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      <% @results.each_with_index do |result, index| %>
        <%= render "meetups/stop", result: result, rank: index, total: @results.size, best: best %>
      <% end %>
    </div>
  </section>
<% end %>
