<% content_for :head do %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css">
<% end %>

<% names = @group_codes.map { |code| @origins.dig(code, :name) }.compact %>
<% best, *others = @results %>

<%= link_to "Change stations", root_path, class: "text-sm font-medium text-steel hover:text-ink" %>

<% if best.nil? %>
  <p class="mt-6 text-lg">There's no station everyone can reach by train. Try a different set of stations.</p>
<% else %>
  <p class="mt-6 text-steel">Fairest stop for <%= names.to_sentence %></p>

  <div class="mt-3">
    <%= render "shared/station_sign", name: best.name, romaji: best.romaji, longest: best.longest,
          badges: @badges[best.group_code], aria_label: "Fairest station" %>
  </div>

  <div data-controller="route-map"
       data-route-map-data-value="<%= @map_data.to_json %>"
       class="isolate mt-4 h-72 overflow-hidden rounded-3xl border border-rail bg-sign"
       role="img"
       aria-label="Map of everyone's route to <%= best.romaji || best.name %>"></div>

  <div class="mt-4 flex flex-wrap items-center gap-2">
    <div data-controller="share"
         data-share-url-value="<%= meet_url(from: @group_codes) %>"
         data-share-title-value="Meet at <%= best.romaji || best.name %>"
         data-share-text-value="Fairest spot for us: <%= best.name %> (<%= best.romaji %>). Longest trip <%= best.longest %> min."
         class="contents">
      <button type="button" hidden data-share-target="share" data-action="share#share"
              class="rounded-full bg-ink px-5 py-2 font-bold text-white hover:bg-steel cursor-pointer">Share</button>
      <button type="button" data-share-target="copy" data-action="share#copy"
              class="rounded-full bg-ink px-5 py-2 font-bold text-white hover:bg-steel cursor-pointer">Copy link</button>
    </div>
    <%= render "saved_spots/button", code: best.group_code %>
  </div>

  <div class="mt-3">
    <%= render "saved_groups/form", codes: @group_codes %>
  </div>

  <section class="mt-8">
    <h2 class="font-bold">Everyone's trip</h2>
    <ul class="mt-3 divide-y divide-rail rounded-2xl border border-rail bg-sign">
      <% @group_codes.each_with_index do |code, person| %>
        <li class="flex items-center justify-between gap-4 px-5 py-3">
          <span class="flex min-w-0 items-center gap-2">
            <span class="flex shrink-0 gap-1"><%= line_badges(@badges[code], size: :sm, limit: 2) %></span>
            <span class="min-w-0 truncate">
              <span lang="ja"><%= @origins.dig(code, :name) %></span>
              <span class="text-steel"><%= @origins.dig(code, :romaji) %></span>
            </span>
          </span>
          <span class="shrink-0 font-bold tabular-nums">
            <%= best.minutes[person].zero? ? "Already there" : "#{best.minutes[person]} min" %>
          </span>
        </li>
      <% end %>
    </ul>
  </section>

  <section class="mt-8">
    <h2 class="font-bold">Around <%= best.romaji || best.name %></h2>
    <%= turbo_frame_tag "nearby", src: places_path(best.group_code), loading: :lazy do %>
      <p class="mt-3 text-steel">Looking for places near <%= best.name %>…</p>
    <% end %>
    <p class="mt-4 text-xs text-steel">
      Place data © <%= link_to "OpenStreetMap contributors", "https://www.openstreetmap.org/copyright", class: "underline", target: "_blank", rel: "noopener" %>
    </p>
  </section>

  <% if others.any? %>
    <section class="mt-8">
      <h2 class="font-bold">Close runners-up</h2>
      <div class="mt-3 divide-y divide-rail rounded-2xl border border-rail bg-sign">
        <% others.each do |result| %>
          <details class="group px-5 py-3">
            <summary class="flex cursor-pointer list-none items-baseline justify-between gap-4">
              <span>
                <span class="font-bold" lang="ja"><%= result.name %></span>
                <span class="text-steel"><%= result.romaji %></span>
              </span>
              <span class="shrink-0 text-steel tabular-nums">
                longest <span class="font-bold text-ink"><%= result.longest %> min</span>
                <span class="ml-1 inline-block transition-transform group-open:rotate-90" aria-hidden="true">›</span>
              </span>
            </summary>
            <ul class="mt-2 space-y-1 text-sm text-steel">
              <% @group_codes.each_with_index do |code, person| %>
                <li class="flex justify-between">
                  <span>from <%= @origins.dig(code, :romaji) || @origins.dig(code, :name) %></span>
                  <span class="tabular-nums"><%= result.minutes[person].zero? ? "already there" : "#{result.minutes[person]} min" %></span>
                </li>
              <% end %>
            </ul>
          </details>
        <% end %>
      </div>
    </section>
  <% end %>
<% end %>
